<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  pom.xml  -  Descriptor de Maven (Project Object Model)
  ============================================================================
  Define QUE es el proyecto (coordenadas), CON QUE se construye (dependencias)
  y COMO se empaqueta (plugins). Maven descarga las dependencias declaradas
  aquí y todas sus dependencias transitivas.

  Stack del ejercicio (solo lo que pide la consigna):
    - Spring Boot (web + MVC)            -> capa de controladores
    - Thymeleaf                          -> motor de plantillas de la vista
    - Spring Data JPA (Hibernate) + MySQL-> ORM y persistencia
    - Bean Validation                    -> validaciones de los formularios
    - Lombok                             -> reduce código repetitivo (getters/setters)
    - spring-security-crypto              -> SOLO la función de hash BCrypt para
                                            no guardar claves en texto plano
                                            (NO incluye filtros, roles ni login de
                                            Spring Security: no se usa "seguridad").
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent: hereda la gestion de versiones de Spring Boot. Por eso las
         dependencias de abajo NO llevan <version>: las fija el parent. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/> <!-- resuelve el parent desde el repositorio, no desde el disco -->
    </parent>

    <!-- Coordenadas del proyecto -->
    <groupId>com.isw2</groupId>
    <artifactId>accesousuarios</artifactId>
    <version>1.0.0</version>
    <name>accesousuarios</name>
    <description>ISW2 - Registro e ingreso de usuarios (MVC + Thymeleaf + JPA + MySQL)</description>

    <properties>
        <!-- JDK 21 (el que se usa en toda la materia) -->
        <java.version>21</java.version>
        <!-- Lombok fijado explicitamente para evitar incompatibilidades con el JDK -->
        <lombok.version>1.18.38</lombok.version>
    </properties>

    <dependencies>
        <!-- Spring MVC + Tomcat embebido + Jackson. Aporta @Controller, @GetMapping, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Thymeleaf: motor de plantillas de la VISTA (templates/*.html) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Spring Data JPA + Hibernate: ORM (mapea clases Java a tablas) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation (jakarta.validation): @NotBlank, @Email, @Past, @Size... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Driver JDBC de MySQL. scope=runtime: solo se necesita al ejecutar -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Solo la utilidad de hash BCrypt. No activa ninguna configuración de seguridad. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Lombok: genera getters/setters/constructores en compilación -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Empaqueta el JAR ejecutable y permite "mvn spring-boot:run" -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
