<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  pom.xml  -  Descriptor Maven del "Sistema de Gestión Escolar"
  ============================================================================
  Maven descarga las dependencias, compila el proyecto y lo empaqueta.
  Comandos útiles (desde la carpeta donde está este archivo):
      mvn clean package         -> compila y genera target/sistemaescolar-1.0.0.jar
      mvn spring-boot:run       -> arranca la aplicación (http://localhost:8080)

  Decisiones de versiones (coherentes con el proyecto "fitnessclub"):
    * Spring Boot 3.3.5  -> Spring Framework 6, Spring Security 6, Hibernate 6.5.
    * Java 17            -> mínimo exigido por Spring Boot 3 (funciona con JDK 17 o 21).
    * Lombok 1.18.38     -> versión fijada a mano para evitar incompatibilidades con el JDK.
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- El "parent" de Spring Boot aporta: versiones compatibles de todas las librerías
         (dependencyManagement), configuración de plugins y codificación UTF-8. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.colegio</groupId>
    <artifactId>sistemaescolar</artifactId>
    <version>1.0.0</version>
    <name>sistemaescolar</name>
    <description>Sistema de gestión escolar: alumnos, grados, aulas, docentes y notas por materia</description>

    <properties>
        <java.version>21</java.version>
        <!-- Se fija la versión de Lombok (ver README, sección "Problemas conocidos"). -->
        <lombok.version>1.18.38</lombok.version>
    </properties>

    <dependencies>
        <!-- CAPA WEB (Controller): Spring MVC + Tomcat embebido. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- CAPA VISTA (View): motor de plantillas Thymeleaf (HTML renderizado en el servidor). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Integra Spring Security con Thymeleaf: habilita sec:authorize / sec:authentication en el HTML. -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <!-- CAPA DE DATOS (ORM): Spring Data JPA + Hibernate. Incluye también la auditoría de entidades. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver JDBC de MySQL (también funciona con el MariaDB de XAMPP). -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- VALIDACIÓN de los DTO (@NotBlank, @Email, @Past, etc. de Jakarta Bean Validation). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- SEGURIDAD: autenticación por formulario, BCrypt, CSRF, autorización por roles. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- CORREO: JavaMailSender para enviar el mail de bienvenida al docente. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- LOMBOK: genera getters/setters/constructores en tiempo de compilación. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
            <!-- Tests: JUnit 5 + Mockito + AssertJ (los tests unitarios no necesitan MySQL) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Declara Lombok como procesador de anotaciones (necesario en JDK 23+ y más robusto en general). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Empaqueta el JAR ejecutable y permite "mvn spring-boot:run". -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
